+# ─── GFC Stress Calibration (Fix B — CRE53) ──────────────────────────────────
+@dataclass
+class GFCStressConfig:
+    """
+    Empirically-calibrated GFC 2007-09 stressed volatilities for IMM.
+    Source: BIS Working Paper, BCBS stress calibration guidance, market data.
+
+    These replace the prior 2× base shortcut in MarketParams.stressed_vol.
+    Each value is the annualised realised volatility observed during the
+    2007-01-01 to 2009-12-31 stress window per CRE53 §stress calibration.
+
+    Regulatory basis: CRE53 requires the stress period to cover a period of
+    significant financial stress relevant to the bank's portfolio. The
+    2007-09 GFC window is the canonical BCBS reference period.
+    """
+    # Equity — S&P 500 realized vol (CBOE VIX avg ~32%, realized ~38%)
+    eq_stressed_vol:    float = 0.38
+    # FX — Major pair realized vol (EURUSD, USDJPY ~15-18%)
+    fx_stressed_vol:    float = 0.18
+    # IR — 10Y UST absolute rate std (200bp move in 6m → σ_r ≈ 0.020)
+    ir_stressed_vol:    float = 0.020
+    # CR — IG CDX credit-spread log-vol (spread 70bp→280bp over 18m)
+    cr_stressed_vol:    float = 0.65
+    # CMDTY — WTI crude realized vol (oil $147→$35; daily vol ~3.5%/day)
+    cmdty_stressed_vol: float = 0.58
+
+    stress_window_start: str = "2007-01-01"
+    stress_window_end:   str = "2009-12-31"
+
+GFC_STRESS = GFCStressConfig()
